<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>SCLauncher</AssemblyName>
		<RootNamespace>SCLauncher.UI</RootNamespace>
		<Nullable>enable</Nullable>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\logo-sc.ico</ApplicationIcon>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<DebugType>embedded</DebugType>
		<!-- Publish repository for updater -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishTrimmed>true</PublishTrimmed>
		<!-- Octokit and DepotDownloaderSubProcess dependency tree are not trim compatible -->
		<TrimMode>partial</TrimMode>
		<!-- Enabling <PublishTrimmed> defaults the ILLink feature switch _DefaultValueAttributeSupport to false, 
		breaking protobuf-net contracts with [DefaultValue] inside SteamKit2 library -->
		<_DefaultValueAttributeSupport>true</_DefaultValueAttributeSupport>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SCLauncher.Shared\SCLauncher.Shared.csproj" />
		<ProjectReference Include="..\SCLauncher.Backend\SCLauncher.Backend.csproj" />
		<!-- This lib is not trim ready -->
		<TrimmerRootAssembly Include="Tmds.ExecFunction" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.2.999-cibuild0100014-alpha" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
		<PackageReference Include="Avalonia.Desktop" Version="12.2.999-cibuild0100014-alpha" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.999-cibuild0100014-alpha" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.999-cibuild0100014-alpha" />
		<!--Condition below is needed to remove AvaloniaUI.DiagnosticsSupport package from build output in Release configuration.-->
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
		<PackageReference Include="Optris.LoadingIndicators.Avalonia" Version="12.0.4" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="MarkView.Avalonia" Version="12.4.0" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>
</Project>
