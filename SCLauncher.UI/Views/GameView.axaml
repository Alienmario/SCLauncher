<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:config="using:SCLauncher.Shared.Model.Config"
             xmlns:controls="using:SCLauncher.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="SCLauncher.UI.Views.GameView"
             x:DataType="config:ClientConfiguration">

	<UserControl.Effect>
		<DropShadowDirectionEffect BlurRadius="10" ShadowDepth="-5"/>
	</UserControl.Effect>

	<DockPanel VerticalSpacing="10">

		<SplitButton DockPanel.Dock="Bottom"
		             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
		             Classes="accent" FontSize="16" FontWeight="Bold"
		             Content="Launch game"
		             Name="LaunchButton"
		             Click="OnLaunchGameClicked">
			<SplitButton.Flyout>
				<MenuFlyout Placement="TopEdgeAlignedRight">
					<MenuItem Header="Reset launch options" Click="OnConfiguratorResetClicked">
						<MenuItem.Icon>
							<PathIcon Data="{StaticResource arrow_undo_regular}" Height="12" Width="12" Foreground="Firebrick"/>
						</MenuItem.Icon>
					</MenuItem>
				</MenuFlyout>
			</SplitButton.Flyout>
		</SplitButton>

		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="0 0 0 10">
				<StackPanel.Styles>
					<Style Selector="GroupBox">
						<Setter Property="Background" Value="{StaticResource BackgroundPane}"/>
						<Setter Property="CornerRadius" Value="10"/>
					</Style>
					<Style Selector="StackPanel.Param">
						<Setter Property="Orientation" Value="Horizontal"/>
						<Setter Property="VerticalAlignment" Value="Center"/>
						<Setter Property="Spacing" Value="6"/>
						<Style Selector="^ > controls|InfoIcon">
							<Setter Property="RenderTransform" Value="Scale(0.85)"/>
						</Style>
					</Style>
				</StackPanel.Styles>

				<GroupBox Background="{StaticResource BackgroundPane4}" BorderBrush="Transparent" CornerRadius="20">
					<GroupBox.Header>
						<TextBlock Text="Launch options" Classes="SectionHeader" FontSize="15"/>
					</GroupBox.Header>
					<StackPanel Spacing="20" Margin="0 10 0 0">
						<!-- Common/engine -->
						<GroupBox>
							<GroupBox.Header>
								<TextBlock Text="Engine" Classes="SectionHeader"/>
							</GroupBox.Header>
							<FlexPanel Wrap="Wrap" JustifyContent="SpaceBetween" ColumnSpacing="20" RowSpacing="10">
								<StackPanel Classes="Param">
									<CheckBox Content="Insecure" IsChecked="{Binding Insecure}"/>
									<controls:InfoIcon Text="Disables Valve Anti-Cheat (VAC).&#10;Required to join insecure servers or use certain client-side mods.&#10;&#10;(-insecure)"/>
								</StackPanel>
								<StackPanel Classes="Param">
									<CheckBox Content="Developer mode" IsChecked="{Binding Dev}"/>
									<controls:InfoIcon Text="Enables developer mode&#10;- shows extra console output and debug overlays&#10;- disables dynamic menu backgrounds&#10;&#10;(-dev)"/>
								</StackPanel>
								<StackPanel Classes="Param">
									<CheckBox Content="Multiple instances" IsChecked="{Binding Multirun}"/>
									<controls:InfoIcon Text="Enables launching additional instances of the game.&#10;&#10;(-multirun)"/>
								</StackPanel>
								<StackPanel Classes="Param">
									<ComboBox Name="WindowModeCombo" SelectedIndex="{Binding WindowMode}"/>
								</StackPanel>
							</FlexPanel>
						</GroupBox>

						<!-- Game specific -->
						<ContentControl Content="{Binding}"/>

						<!-- Custom entry -->
						<GroupBox IsVisible="{Binding CustomParams.Count}">
							<GroupBox.Header>
								<TextBlock Text="Custom" Classes="SectionHeader"/>
							</GroupBox.Header>
							<controls:CustomParamEntry DataContext="{Binding CustomParams}" ShowHint="False"/>
						</GroupBox>
						<controls:CustomParamEntry DataContext="{Binding CustomParams}" ShowHint="False"
						                           IsVisible="{Binding !Count}"/>
					</StackPanel>
				</GroupBox>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>

	<!-- Game specific templates -->
	<UserControl.DataTemplates>

		<!-- BlackMesa -->
		<DataTemplate DataType="config:ClientConfigurationBlackMesa">
			<GroupBox>
				<GroupBox.Header>
					<TextBlock Text="Black Mesa" Classes="SectionHeader"/>
				</GroupBox.Header>
				<FlexPanel Wrap="Wrap" JustifyContent="SpaceBetween" ColumnSpacing="20" RowSpacing="10">
					<StackPanel Classes="Param">
						<CheckBox Content="Workshop" IsChecked="{Binding Workshop}"/>
						<controls:InfoIcon Text="Enables loading subscribed Workshop items.&#10;&#10;(+workshop_disable 1 when unchecked)"/>
					</StackPanel>
					<StackPanel Classes="Param">
						<CheckBox Content="Force Direct3D 9" IsChecked="{Binding ForceUiD3D9}"/>
						<controls:InfoIcon Text="Forces the game's UI to render using Direct3D 9.&#10;&#10;(-forceuid3d9)"/>
					</StackPanel>
					<StackPanel Classes="Param">
						<CheckBox Content="DXVK" IsChecked="{Binding DXVK}"/>
						<controls:InfoIcon Text="Enables the DXVK (Direct3D over Vulkan) translation layer.&#10;&#10;(-disabledxvk when unchecked)"/>
					</StackPanel>
					<StackPanel Classes="Param">
						<CheckBox Content="Old UI" IsChecked="{Binding OldUI}"/>
						<controls:InfoIcon Text="Forces legacy Source engine UI instead of Black Mesa's modern UI.&#10;&#10;(-oldgameui)"/>
					</StackPanel>
				</FlexPanel>
			</GroupBox>
		</DataTemplate>

		<!-- empty fallback -->
		<DataTemplate DataType="config:ClientConfiguration"/>

	</UserControl.DataTemplates>

</UserControl>