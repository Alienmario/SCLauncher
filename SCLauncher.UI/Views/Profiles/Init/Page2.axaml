<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:SCLauncher.UI.Converters"
             xmlns:init="using:SCLauncher.UI.Views.Profiles.Init"
             xmlns:generic="using:System.Collections.Generic"
             xmlns:wizard="using:SCLauncher.UI.Controls.Wizard"
             mc:Ignorable="d" d:DesignWidth="525" d:DesignHeight="400"
             x:Class="SCLauncher.UI.Views.Profiles.Init.Page2"
             x:DataType="{x:Type generic:IEnumerable, x:TypeArguments=init:Page2+Item}"
             wizard:TextNavBar.Text="Select presets (optional)">
	
	<ScrollViewer>
		<!-- Outer list (Items) -->
		<ItemsControl ItemsSource="{Binding}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel ItemSpacing="50" LineSpacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<StackPanel MinWidth="200">
						<TextBlock FontWeight="Bold" TextAlignment="Center"
						           Text="{Binding AppType, Converter={x:Static converters:EnumDescriptionConverter.Instance}}"/>
						
						<!-- Inner list (Presets) -->
						<ListBox Background="Transparent" HorizontalAlignment="Center"
						         ItemsSource="{Binding Presets}"
						         SelectedItem="{Binding SelectedPreset}"
						         AutoScrollToSelectedItem="False">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel ItemSpacing="10" LineSpacing="10" Margin="10"/>
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.Styles>
								<Style Selector="ListBoxItem">
									<Setter Property="CornerRadius" Value="50"/>
									<Setter Property="FontSize" Value="12"/>
									<Setter Property="BorderBrush" Value="{DynamicResource BackgroundPane2}"/>
									<Setter Property="BorderThickness" Value="1"/>
									<Setter Property="Padding" Value="10"/>
								</Style>
							</ListBox.Styles>
						</ListBox>
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</ScrollViewer>
	
</UserControl>
