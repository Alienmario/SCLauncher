<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wizard="using:SCLauncher.UI.Controls.Wizard"
        mc:Ignorable="d"
        x:Class="SCLauncher.UI.Views.Profiles.Init.InitializeProfilesDialog"
        Background="{StaticResource WindowBackground}"
        Title="Setup profiles"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="525" MinHeight="300"
        CanResize="False"
        ShowInTaskbar="True">

		<wizard:WizardNavigator Name="Wizard" Margin="10 20 10 10" Exit="OnWizardExit">
			<wizard:WizardNavigator.NavBar>
				<wizard:TextNavBar/>
			</wizard:WizardNavigator.NavBar>
		</wizard:WizardNavigator>

</Window>
