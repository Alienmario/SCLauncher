<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SCLauncher.ui.views"
        xmlns:controls="clr-namespace:SCLauncher.ui.controls"
        xmlns:profiles="clr-namespace:SCLauncher.ui.views.profiles"
        mc:Ignorable="d"
        x:Class="SCLauncher.ui.views.MainWindow"
        Title="SCLauncher"
        Icon="/ui/assets/logo-sc.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{OnPlatform Linux=20, Default=-1}"
        WindowDrawnDecorations.TitleBarDecorations="MinimizeButton, MaximizeButton, CloseButton"
        TransparencyLevelHint="Mica,AcrylicBlur,None"
        WindowStartupLocation="CenterScreen"
        Width="700" Height="450"
        MinWidth="600" MinHeight="300">

	<Window.Styles>
		<Style Selector="Window">
			<Setter Property="Background" Value="{StaticResource WindowBackground}"/>
		</Style>
		<Style Selector="Window[ActualTransparencyLevel=Mica], Window[ActualTransparencyLevel=AcrylicBlur]">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		
		<Style Selector="TabItem">
			<Style Selector="^ PathIcon#SettingsCog">
				<Setter Property="RenderTransform" Value="rotate(0)"/>
				<Setter Property="Transitions">
					<Transitions>
						<TransformOperationsTransition Property="RenderTransform" Duration="0:0:1" Easing="CubicEaseOut"/>
					</Transitions>
				</Setter>
			</Style>
			<Style Selector="^:pointerover PathIcon#SettingsCog">
				<Setter Property="RenderTransform" Value="rotate(120deg)"/>
			</Style>
		</Style>
	</Window.Styles>
	
	<Panel>
		
		<!-- W10 fallback (AcrylicBlur) -->
		<ExperimentalAcrylicBorder IsHitTestVisible="False" IsVisible="{Binding 
						Path=$parent[Window].ActualTransparencyLevel,
						Converter={x:Static ObjectConverters.Equal},
						ConverterParameter={x:Static WindowTransparencyLevel.AcrylicBlur}}">
			<ExperimentalAcrylicBorder.Material>
				<ExperimentalAcrylicMaterial
					BackgroundSource="Digger"
					TintColor="Black"
					TintOpacity="0.7"
					MaterialOpacity="0.9"/>
			</ExperimentalAcrylicBorder.Material>
		</ExperimentalAcrylicBorder>
		
		<DockPanel>
			
			<!-- Custom titlebar -->
			<DockPanel DockPanel.Dock="Top" Margin="10 5" HorizontalSpacing="10"
			           WindowDecorationProperties.ElementRole="TitleBar">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Border CornerRadius="4" ClipToBounds="True">
						<Image Source="/ui/assets/logo-sc.ico" Width="70" RenderOptions.BitmapInterpolationMode="HighQuality"/>
					</Border>
				</StackPanel>
				<profiles:ProfileSwitcher WindowDecorationProperties.ElementRole="User" VerticalAlignment="Top"/>
			</DockPanel>

			<controls:UpdateNotification DockPanel.Dock="Bottom" Opacity="0.9"/>

			<!-- Padding: ads extra space above content, preserves side spacing -->
			<!-- Margin: corrects the header position with titlebar -->
			<TabControl DockPanel.Dock="Top" Name="Tabs" Margin="0 -5 0 0" Padding="10 15 10 10" ClipToBounds="False">
				
				<TabControl.ItemsPanel>
					<ItemsPanelTemplate>
						<!-- Custom alignment of the header -->
						<DockPanel Margin="85 -50 0 0"/>
					</ItemsPanelTemplate>
				</TabControl.ItemsPanel>
				
				<TabItem Name="HostServerTab" Header="Host server">
					<views:HostServer/>
				</TabItem>
				
				<TabItem Name="JoinServerTab" Header="Join server">
					<views:JoinServer/>
				</TabItem>
				
				<TabItem Name="GameTab" Header="Game">
					<views:Game/>
				</TabItem>
				
				<TabItem Name="ModsTab" Header="Mods">
					<views:Mods/>
				</TabItem>
				
				<TabItem Name="SettingsTab" HorizontalAlignment="Right">
					<TabItem.Header>
						<Panel Classes="TabItemHeader">
							<PathIcon Name="SettingsCog" Data="{StaticResource settings_regular}"/>
						</Panel>
					</TabItem.Header>
					<views:Settings/>
				</TabItem>
				
			</TabControl>
		</DockPanel>
	</Panel>
	
</Window>