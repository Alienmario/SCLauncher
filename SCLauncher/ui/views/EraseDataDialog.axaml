<controls:BaseDialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SCLauncher.ui.controls"
        mc:Ignorable="d"
        x:Class="SCLauncher.ui.views.EraseDataDialog"
        Title="Erase Local Data"
        CanResize="False">

	<controls:BaseDialogWindow.MainContent>
		<TextBlock Margin="10 10 10 0" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
		           TextWrapping="Wrap" FontSize="16" LineSpacing="10">
			<Run Text="Are you sure you want to erase all local data?"/>
			<LineBreak/>
			<Run Text="This will delete all settings, profiles and cached data." FontSize="13"
			     Foreground="{DynamicResource TextControlForegroundDisabled}"/>
		</TextBlock>
	</controls:BaseDialogWindow.MainContent>

	<controls:BaseDialogWindow.FooterContent>
		<DockPanel Margin="20" HorizontalSpacing="15">
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
				<Button Name="CancelButton" Content="Cancel" Classes="action" HotKey="Escape"/>
				<Button Name="EraseButton" Content="Erase all" Classes="action danger" HotKey="Enter"/>
			</StackPanel>
		</DockPanel>
	</controls:BaseDialogWindow.FooterContent>

</controls:BaseDialogWindow>
