<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:custom="clr-namespace:SCLauncher.ui.controls"
             xmlns:ui="clr-namespace:SCLauncher.ui"
             xmlns:config="clr-namespace:SCLauncher.model.config"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="250"
             x:Class="SCLauncher.ui.views.Settings"
             x:DataType="config:AppProfile">

	<UserControl.Effect>
		<DropShadowDirectionEffect BlurRadius="10" ShadowDepth="-5"/>
	</UserControl.Effect>

	<DockPanel VerticalSpacing="10">

		<!-- Version -->
		<TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" HorizontalAlignment="Right"
		           Foreground="{DynamicResource TextControlForegroundDisabled}" FontSize="12">
			<Run>SCLauncher</Run>
			<Run Text="{x:Static ui:App.Version}"/>
		</TextBlock>
		
		<ScrollViewer DockPanel.Dock="Top" Classes="RightMargin" HorizontalScrollBarVisibility="Disabled">
			<StackPanel>
				<StackPanel.Styles>
					<Style Selector="Label,CheckBox">
						<Setter Property="VerticalAlignment" Value="Center"/>
						<Setter Property="HorizontalAlignment" Value="Left"/>
						<Setter Property="Margin" Value="0 10 0 0"/>
					</Style>
					<Style Selector="TextBlock.SectionHeader">
						<Setter Property="Padding" Value="10 0 0 0"/>
					</Style>
					<Style Selector="Border.SectionContent">
						<Setter Property="Background" Value="{DynamicResource BackgroundPane}"/>
						<Setter Property="Margin" Value="0 0 0 10"/>
						<Style Selector="^ StackPanel">
							<Setter Property="Margin" Value="10 0 10 10"/>
						</Style>
					</Style>
				</StackPanel.Styles>

				<TextBlock Text="App settings" Classes="SectionHeader"/>

				<Border Classes="SectionContent">
					<StackPanel x:DataType="config:GlobalConfiguration" Name="GlobalConfigContent">
						<CheckBox IsChecked="{Binding CheckForUpdates}" Name="CheckForUpdatesCheckBox">
							Notify for launcher updates
						</CheckBox>

						<Label Content="Steam installation path"/>
						<custom:FilePickerTextBox Mode="Folder" Title="Select Steam installation folder" Name="SteamPath"
						                          Text="{Binding SteamPath}"/>

						<Label Content="Steam Web API Key (for server browser)"/>
						<TextBox Text="{Binding SteamWebApiKey}" Name="SteamApiKey">
							<TextBox.InnerRightContent>
								<HyperlinkButton NavigateUri="https://steamcommunity.com/dev/apikey" Name="SteamApiKeyLink">
									<PathIcon Data="{StaticResource open_folder_regular}"
									          Foreground="{StaticResource Highlight}"
									          Height="16"/>
								</HyperlinkButton>
							</TextBox.InnerRightContent>
						</TextBox>
					</StackPanel>
				</Border>

				<TextBlock Text="Active profile settings" Classes="SectionHeader"/>
				
				<Border Classes="SectionContent">
					<StackPanel>
						<Label Content="Game path"/>
						<custom:FilePickerTextBox Mode="Folder" Title="Select game path" Name="GamePath"
						                          Text="{Binding GamePath}"/>

						<Label Content="Server path"/>
						<custom:FilePickerTextBox Mode="Folder" Title="Select server path" Name="ServerPath"
						                          Text="{Binding ServerPath}"/>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>

</UserControl>