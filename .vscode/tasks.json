                "--self-contained", "true",
                "-p:PublishSingleFile=true",
                "-p:PublishReadyToRun=true",
                "-p:IncludeNativeLibrariesForSelfExtract=true"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish: linux-x64 (Debug)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish", "${workspaceFolder}/SCLauncher.UI",
                "-c", "Debug",
                "-r", "linux-x64",
                "-o", "out",
                "--self-contained", "true",
                "-p:PublishSingleFile=true",
                "-p:PublishReadyToRun=true",
                "-p:IncludeNativeLibrariesForSelfExtract=true"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
